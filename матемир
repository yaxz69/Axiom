<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Математика 5-11 Классы</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col font-sans">

    <!-- Шапка -->
    <header class="bg-slate-800 border-b border-slate-700 p-4 text-center shadow-md">
        <h1 class="text-xl font-bold text-emerald-400">Math Boost 5-11</h1>
        <p class="text-xs text-slate-400">Твой карманный помощник по математике</p>
    </header>

    <!-- Основной контент -->
    <main class="flex-1 p-4 max-w-md mx-auto w-full">
        <h2 class="text-lg font-semibold mb-3 text-slate-200">Выбери свой класс:</h2>
        
        <!-- Сетка классов -->
        <div class="grid grid-cols-2 gap-3">
            <button onclick="openClass(5)" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 p-4 rounded-xl text-left transition">
                <div class="text-xl font-bold text-emerald-400">5 класс</div>
                <div class="text-xs text-slate-400 mt-1">Дроби, арифметика</div>
            </button>
            <button onclick="openClass(7)" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 p-4 rounded-xl text-left transition">
                <div class="text-xl font-bold text-emerald-400">7 класс</div>
                <div class="text-xs text-slate-400 mt-1">Алгебра, геометрия</div>
            </button>
            <button onclick="openClass(9)" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 p-4 rounded-xl text-left transition">
                <div class="text-xl font-bold text-emerald-400">9 класс</div>
                <div class="text-xs text-slate-400 mt-1">Квадратные корни, ОГЭ</div>
            </button>
            <button onclick="openClass(11)" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 p-4 rounded-xl text-left transition">
                <div class="text-xl font-bold text-emerald-400">11 класс</div>
                <div class="text-xs text-slate-400 mt-1">Производные, ЕНТ/ЕГЭ</div>
            </button>
        </div>

        <!-- Окно для тем -->
        <div id="content-area" class="mt-6 hidden bg-slate-800 border border-slate-700 p-4 rounded-xl">
            <h3 id="class-title" class="font-bold text-emerald-400 mb-2"></h3>
            <p id="class-desc" class="text-sm text-slate-300"></p>
            <button onclick="goBack()" class="mt-4 bg-slate-700 hover:bg-slate-600 px-3 py-1.5 rounded-lg text-xs">Назад к классам</button>
        </div>
    </main>

    <!-- Скрипт логики -->
    <script>
        function openClass(grade) {
            document.querySelector('.grid').classList.add('hidden');
            const area = document.getElementById('content-area');
            area.classList.remove('hidden');
            
            document.getElementById('class-title').innerText = grade + ' класс: Темы и теория';
            document.getElementById('class-desc').innerText = `Здесь будет собрана вся теория, формулы и тесты для ${grade}-го класса. Скоро добавим интерактивные тренажеры!`;
        }

        function goBack() {
            document.querySelector('.grid').classList.remove('hidden');
            document.getElementById('content-area').classList.add('hidden');
        }
    </script>
</body>
</html>

